        "# 24 - Implemente uma função para validar um CPF brasileiro.\n",
        "\n",
        "def validar_cpf(cpf):\n",
        "    cpf = cpf.replace(\".\", \"\").replace(\"-\", \"\")  # Removi pontos e traços para trabalhar somente com os números.\n",
        "\n",
        "    # Organizei as validações do mais simples para o cálculo, evitando erros antes de usar int().\n",
        "\n",
        "    if len(cpf) != 11:\n",
        "        return False\n",
        "\n",
        "    if not cpf.isdigit():  # Verifico se o CPF contém somente números.\n",
        "        return False\n",
        "\n",
        "    if cpf == cpf[0] * 11:  # Rejeito CPFs formados pelo mesmo número repetido.\n",
        "        return False\n",
        "\n",
        "    # Aqui começam os cálculos dos dígitos verificadores.\n",
        "    soma = 0\n",
        "\n",
        "    for i in range(9):  # Usei o for para fazer o cálculo do primeiro dígito verificador.\n",
        "        soma += int(cpf[i]) * (10 - i)\n",
        "\n",
        "    resto = soma % 11\n",
        "\n",
        "    if resto < 2:\n",
        "        primeiro = 0\n",
        "    else:\n",
        "        primeiro = 11 - resto\n",
        "\n",
        "    if primeiro != int(cpf[9]):  # Verifico se o primeiro dígito calculado é igual ao informado no CPF.\n",
        "        return False\n",
        "\n",
        "    soma = 0\n",
        "\n",
        "    for i in range(10):  # Repito o cálculo para encontrar o segundo dígito verificador.\n",
        "        soma += int(cpf[i]) * (11 - i)\n",
        "\n",
        "    resto = soma % 11\n",
        "\n",
        "    if resto < 2:\n",
        "        segundo = 0\n",
        "    else:\n",
        "        segundo = 11 - resto\n",
        "\n",
        "    if segundo != int(cpf[10]):  # Verifico se o segundo dígito calculado é igual ao informado no CPF.\n",
