        "# 31 - Implemente o algoritmo de ordenação por bolha (Bubble Sort)\n",
        "# Utilizei uma função para ordenar a lista usando o Bubble Sort. Usei dois laços for, onde o primeiro controla a quantidade de passadas e o segundo compara os elementos vizinhos da lista. Quando um elemento é maior que o próximo, eles trocam de posição. Ao final das comparações, a lista fica ordenada em ordem crescente.\n",
        "def bubbleSort(lista):\n",
        "    tamanho = len(lista)\n",
        "\n",
        "    for i in range(tamanho):\n",
        "        for j in range(0, tamanho - i - 1):\n",
        "            if lista[j] > lista[j + 1]:\n",
        "                lista[j], lista[j + 1] = lista[j + 1], lista[j]\n",
        "\n",
        "    return lista\n",
        "\n",
        "\n",
        "numeros = [8, 3, 5, 1, 9, 2]\n",
        "\n",
        "print(\"Lista original:\", numeros)\n",
        "print(\"Lista ordenada:\", bubbleSort(numeros))\n"
